# Ignore entire labeled data
Labeled Data/

# Ignore scans
app/Scans/

# Ignore saved images
app/Saved Images/

# Ignore user-created scan search profiles
app/Profiles/

# Persistent microscope calibration images. These are ignored so they are not
# mistaken for disposable untracked test/build output. Never clean these paths.
app/Flatfields/*.png
app/Calibration Backups/Flatfields/*.png
